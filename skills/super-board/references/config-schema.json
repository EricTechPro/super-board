// This file is a REFERENCE DOC, not parsed by the skill at runtime. It uses
// JSON5-style `//` line comments to inline field notes from spec §4 alongside
// the schema. Strip comments before validating an actual config file as JSON.
//
// One config per GitHub project this repo drives, written to
// `.claude/super-board/configs/<slug>.json` (committed). The active
// pointer `.claude/super-board/active` is gitignored and per-machine.

{
  "version": 1,

  // Short scannable label shown when multiple configs are listed.
  // E.g. "staging QA" or "admin build pipeline".
  "description": "<short scannable label, e.g. 'staging QA' or 'admin build pipeline'>",

  "project": {
    "owner": "<github-owner>",
    "title": "<project title on GitHub>",
    // Required; `gh project` CLI takes number, not title (titles aren't unique).
    "number": 0
  },

  // "full" or "qa-only".
  "variant": "qa-only",

  // Worker dispatch backend. "workflow" (default) drains waves in-session via
  // the super-board-wave dynamic workflow (references/run-workflow.md);
  // requires dynamic workflows enabled in /config. "claude-p" is the legacy
  // headless dispatcher (.claude/bin/super-board-run.sh) — explicit opt-in
  // only; the dispatcher refuses to run (exit 78) unless set here.
  "worker_backend": "workflow",

  // Default model ladder for lane workers, indexed by card complexity from
  // the classify router. Overridden per run by `super-board run --low|--high`.
  //   "low"    — haiku (low) / sonnet (medium) / opus (high)
  //   "medium" — (default) sonnet / opus / session model
  //   "high"   — opus floor; medium+ inherit the session model
  "model_tier": "medium",

  "target": {
    // "url" | "repo" | "repo+url". Tells the runner whether to clone, hit a
    // URL, or both.
    "type": "url",
    "url": "<https://your-target-url.example.com>"
  },

  // `null` for URL-only; `{path, remote}` otherwise. `remote` can be `null`
  // for local-only.
  "repo": null,

  // The branch all per-issue branches are cut from and squash-merged back into.
  // Default `"main"`. Onboard warns and suggests `"staging"` or `"develop"` if
  // `main` appears to be production.
  "base_branch": "main",

  // Names of the Status options on the project. Aliases tolerated;
  // canonicalized at read time.
  //
  // Full variant (7):    Ready · Building · QA · Review · Done · Blocked · Skipped
  // QA-only variant (6): Ready ·            QA · Review · Done · Blocked · Skipped
  "columns": ["Ready", "QA", "Review", "Done", "Blocked", "Skipped"],

  "paths": {
    // `null` when no PROJECT.md exists (URL-only flows).
    "project_md": null,
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },

  // When `true`, Reviewer marks the PR ready but does NOT squash-merge; a
  // human must click merge. Card auto-moves to Done when the PR is merged
  // externally. Default `false`. Onboard FORCES this to `true` when
  // `base_branch` is `main` AND the repo has a deploy workflow detected.
  //
  // On the workflow backend, `false` ALSO requires "Bash(gh pr merge:*)" in the
  // session allowlist — without it every Reviewer stalls on an approval prompt
  // and nothing lands. See references/run-workflow.md → "Mid-run permission prompts".
  "human_approves_merge": false,

  // ── Runaway controls (v2.0.0).
  // Halt after this many consecutive dispatch cycles in which NO card reached
  // Done or Skipped. Progress is measured by landed work, never by lane
  // occupancy: a pipeline that is 100% busy and lands nothing is precisely the
  // runaway this gate exists to catch. Default `6`.
  "no_progress_cycles": 6,

  // Hard ceiling on total worker dispatches for one run; the loop halts with a
  // runaway summary when it is reached. `0` disables the ceiling. Bounds
  // worst-case spend even when a board trickles just enough Done movement to
  // keep resetting `no_progress_cycles`. Default `0`.
  "max_dispatches": 0,

  // Controls Reviewer's adversarial mode (folded-in super-truth pattern).
  //   "off"          — never adversarial.
  //   "non-trivial"  — (default) activates on cards with diff ≥10 lines OR
  //                    labels in {security, migration, payments, auth}.
  //   "always"       — every card gets adversarial review
  //                    (cost: 2 sub-agent dispatches per card).
  "truth_gate": "non-trivial",

  // Minimum aggregated sub-agent confidence (0-100) required to approve.
  // Default `70`. Below threshold, Reviewer must NOT approve; card moves to
  // Blocked with `🛡 truth-check failed (confidence X/100)`. See §7.
  "truth_threshold": 70,

  // Shell commands proving the branch still BUILDS against the base branch as it
  // is right now. Run by super-board-merge-gate.sh from the root of a scratch
  // worktree that already has the current base merged in, inside the merge lock,
  // immediately before the squash-merge. Any non-zero exit sends the card back
  // to Build for a rebase pass; it never Blocks.
  //
  // Not optional in practice. GitHub's `mergeable: CLEAN` only answers "does the
  // text conflict" — it says nothing about whether the result compiles. On
  // 2026-08-20 two PRs read CLEAN and failed `tsc` against their own base,
  // because a shared interface had grown after they were tested. Leave this
  // empty and the gate still merges the base in and reports conflicts, but it
  // says loudly that nothing proved the result builds.
  //
  // A fresh worktree has no node_modules, so install as part of the command.
  // Claude plan-usage guard (workflow backend). Before each wave the
  // orchestrator runs super-board-usage.sh check; if the 5-hour or weekly
  // window is at or above this percentage, no new wave launches until it
  // resets. Default 95. See references/run-workflow.md → wave loop step 1.
  "usage_pause_pct": 95,

  "verify_commands": [
    "cd server && npm ci --silent && npm run typecheck && npm test"
  ],

  // Optional throttle on how many cards a single wave dispatches. ABSENT OR 0
  // MEANS UNLIMITED, which is the default and is usually what you want.
  //
  // Wave width is decided by the dependency graph, not by this number: the
  // planner picks every Ready card whose `## Blocked by` issues have all closed,
  // plus whatever is already in flight. The workflow runtime caps CONCURRENT
  // agents at min(16, cpus-2) and queues the rest, so a 19-card wave is normal.
  //
  // Set it only to deliberately throttle a machine. A fixed cap used to do the
  // wave sizing, and it sized it badly: on a board where 23 of 32 Ready cards
  // were waiting on an open blocker, the cap spent its slots on cards that would
  // hit their own preflight and park.
  "max_workers": 0,

  // Max consecutive failures in the same lane on the same root-cause hash
  // before the card auto-moves to Blocked. Default `2`. Root-cause hash
  // defined in §7 Halt gates.
  "rebuild_cap": 2,

  // When the count of Blocked cards exceeds this percent of the initial Ready
  // count, post a mid-run breakdown in the run report. Default `30`. Set to `0`
  // to disable.
  "block_rate_alert_pct": 30,

  // Optional. ui-refine-loop settings (manual runs and the QA lane's qa-hook,
  // run.md → Tester step 5b). Every key is optional; refine-setup.sh detect
  // resolves config key → auto-detection → default. Full notes and the auth
  // script contract: skills/ui-refine-loop/references/config.md.
  "refine": {
    "dev_command": "npm run dev -- --port $PORT",
    "ready_path": "/",
    "check_commands": ["npm run typecheck", "npm run lint"],
    "env_files": [".env.local"],
    "auth_script": "scripts/refine-auth.mjs",
    "states": [{ "name": "main" }],
    "taste_file": "docs/design/taste.md",
    "impeccable": ".agents/skills/impeccable/scripts/impeccable",
    // Manual-mode rounds (default 10) and qa-hook rounds (default 3).
    "rounds": 10,
    "qa_hook_rounds": 3
  },

  // Optional. super-collect bounds. Absent keys use the defaults shown.
  "collect": {
    // Intake window for errors, in days. Default 14.
    "window_days": 14,
    // Error source: "auto" (Sentry, else any wired error tool), a tool name
    // such as "sentry", or false to skip errors. Default "auto".
    "errors": "auto",
    // Repo folders read as feedback. Default ["docs/feedback", "feedback"].
    "feedback_paths": ["docs/feedback", "feedback"],
    // Lookback reads this many newest run files. Default 10.
    "lookback_runs": 10
  },

  "notifications": {
    // super-board sends no messages of its own: reports go to the session and to
    // the issue/PR timeline. `channel` and `chat_id` are reserved and unused.
    "channel": "session",
    "chat_id": null,

    // The assignee identity used as the claim mutex. Read by
    // `super-board status` and `super-board run`. Recorded during onboard
    // step 11 as either `super-board-bot[bot]` (when a GitHub App is
    // installed on the repo) or the user's own GitHub login (solo projects).
    // Pick during step 2 based on what `gh auth status` returned.
    "bot_identity": "auto"
  }
}
